<div class="pw">
  <div class="pw__in">
    <a class="logo" href="{{ routes.root_url }}">
      {% render 'logo-mark' %}
      <span class="logo__txt">{{ settings.logo_text_a }}<em>&amp;</em>{{ settings.logo_text_b }}</span>
    </a>

    <h1>{{ shop.name }}</h1>

    {%- if shop.password_message != blank -%}
      <div class="rte">{{ shop.password_message }}</div>
    {%- else -%}
      <p>We are putting the finishing touches on. Back in a moment.</p>
    {%- endif -%}

    {%- form 'storefront_password' -%}
      {{ form.errors | default_errors }}
      <div class="fld">
        <label for="pw">Enter the store password</label>
        <input type="password" id="pw" name="password" autocomplete="current-password">
      </div>
      <button class="btn btn--gold btn--wide" type="submit">Enter</button>
    {%- endform -%}

    <p class="pw__foot">Are you the owner? <a class="lnk" href="/admin">Log in here</a>.</p>
  </div>
</div>
