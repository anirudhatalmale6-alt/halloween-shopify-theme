{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  {%- comment -%}
    Filters cannot be chained inside a translation argument, so the amount is
    formatted first and the title assembled from the result.
  {%- endcomment -%}
  {%- assign gc_value = gift_card.initial_value | money -%}
  <title>{{ gc_value }} gift card &ndash; {{ shop.name }}</title>
  {% render 'font-face' %}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    :root{
      --bg:{{ settings.color_bg }};--panel:{{ settings.color_panel }};
      --panel2:{{ settings.color_panel2 }};--orange:{{ settings.color_accent }};
      --orange2:{{ settings.color_accent2 }};--green:{{ settings.color_success }};
      --bone:{{ settings.color_text }};--muted:#a398b0;
      --line:{{ settings.color_accent | color_modify: 'alpha', 0.16 }};
    }
    .gc{min-height:100vh;display:grid;place-items:center;padding:40px 20px;text-align:center}
    .gc__in{max-width:460px;width:100%}
    .gc__amt{font-family:'Anton',sans-serif;font-size:clamp(2.6rem,9vw,4rem);color:var(--orange2);line-height:1}
    .gc__code{
      margin-top:1.6rem;padding:1rem;border:1px dashed var(--line);border-radius:12px;
      background:var(--panel);font-size:1.15rem;letter-spacing:3px;word-break:break-all;
    }
    .gc__qr{margin:1.6rem auto 0;display:grid;place-items:center}
    @media print{ body{background:#fff;color:#000} }
  </style>
</head>
<body class="template-gift-card">
  <div class="gc">
    <div class="gc__in">
      <a class="logo" href="{{ shop.url }}" style="justify-content:center;margin-bottom:1.4rem">
        {% render 'logo-mark' %}
        <span class="logo__txt">{{ settings.logo_text_a }}<em>&amp;</em>{{ settings.logo_text_b }}</span>
      </a>

      <p class="sec__k">Gift card</p>
      <p class="gc__amt">{{ gift_card.balance | money }}</p>

      {%- if gift_card.balance != gift_card.initial_value -%}
        <p>Originally {{ gift_card.initial_value | money }}</p>
      {%- endif -%}

      {%- if gift_card.expired -%}
        <p class="cap__msg err">This gift card has expired.</p>
      {%- elsif gift_card.expires_on -%}
        <p>Valid until {{ gift_card.expires_on | date: '%B %-d, %Y' }}</p>
      {%- endif -%}

      <div class="gc__code">{{ gift_card.code | format_code }}</div>

      <div class="gc__qr" id="qr" data-identifier="{{ gift_card.qr_identifier }}"></div>

      <p style="margin-top:1.6rem">
        <a class="btn btn--gold" href="{{ shop.url }}">Spend it</a>
      </p>
      <p class="pw__foot">Use this code at checkout.</p>
    </div>
  </div>

  {%- comment -%}
    defer rather than the script_tag filter, which emits a parser-blocking tag.
    The QR code is decoration below the card number - it must not hold up the
    page, and the code itself is printed as text above regardless.
  {%- endcomment -%}
  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  <script>
    window.addEventListener('DOMContentLoaded', function () {
      var el = document.getElementById('qr');
      if (el && window.QRCode) {
        new QRCode(el, { text: {{ gift_card.qr_identifier | json }}, width: 140, height: 140 });
      }
    });
  </script>
</body>
</html>
