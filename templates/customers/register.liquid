<section class="sec sec--top">
  <div class="wrap wrap--narrow">
    <h1 class="sec__h">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', novalidate: 'novalidate' -%}
      {{ form.errors | default_errors }}
      <div class="fld"><label for="cr-fn">{{ 'customer.register.first_name' | t }}</label>
        <input type="text" id="cr-fn" name="customer[first_name]" autocomplete="given-name"></div>
      <div class="fld"><label for="cr-ln">{{ 'customer.register.last_name' | t }}</label>
        <input type="text" id="cr-ln" name="customer[last_name]" autocomplete="family-name"></div>
      <div class="fld"><label for="cr-em">{{ 'customer.register.email' | t }}</label>
        <input type="email" id="cr-em" name="customer[email]" autocomplete="email" required></div>
      <div class="fld"><label for="cr-pw">{{ 'customer.register.password' | t }}</label>
        <input type="password" id="cr-pw" name="customer[password]" autocomplete="new-password" required></div>
      <button class="btn btn--gold" type="submit">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
