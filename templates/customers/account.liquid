<section class="sec sec--top">
  <div class="wrap">
    <h1 class="sec__h">{{ 'customer.account.title' | t }}</h1>
    <p class="sec__sub">{{ customer.email }} &middot;
      <a class="lnk" href="{{ routes.account_addresses_url }}">{{ 'customer.account.view_addresses' | t }}</a> &middot;
      <a class="lnk" href="{{ routes.account_logout_url }}">Log out</a></p>

    <h2 class="sec__h">{{ 'customer.orders.title' | t }}</h2>
    {%- paginate customer.orders by 20 -%}
      {%- if customer.orders.size > 0 -%}
        <table class="tbl">
          <thead><tr>
            <th>{{ 'customer.orders.order_number' | t }}</th>
            <th>{{ 'customer.orders.date' | t }}</th>
            <th>{{ 'customer.orders.payment_status' | t }}</th>
            <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
            <th>{{ 'customer.orders.total' | t }}</th>
          </tr></thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr>
                <td><a class="lnk" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                <td>{{ order.created_at | date: '%b %-d, %Y' }}</td>
                <td>{{ order.financial_status_label }}</td>
                <td>{{ order.fulfillment_status_label }}</td>
                <td>{{ order.total_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
        {%- if paginate.pages > 1 -%}
          <nav class="pager">
            {%- if paginate.previous -%}<a class="btn btn--ghost" href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
            <span class="pager__n">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {%- if paginate.next -%}<a class="btn btn--ghost" href="{{ paginate.next.url }}">Next</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="sec__empty">{{ 'customer.orders.none' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
