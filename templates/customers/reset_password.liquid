<section class="sec sec--top">
  <div class="wrap wrap--narrow">
    <h1 class="sec__h">{{ 'customer.reset_password.title' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="fld"><label for="rp-pw">{{ 'customer.reset_password.password' | t }}</label>
        <input type="password" id="rp-pw" name="customer[password]" autocomplete="new-password"></div>
      <div class="fld"><label for="rp-pc">{{ 'customer.reset_password.password_confirm' | t }}</label>
        <input type="password" id="rp-pc" name="customer[password_confirmation]" autocomplete="new-password"></div>
      <button class="btn btn--gold" type="submit">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
