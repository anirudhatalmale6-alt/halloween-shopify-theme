[
  {
    "name": "theme_info",
    "theme_name": "Hollow & Hex",
    "theme_version": "1.0.0",
    "theme_author": "Anirudha Talmale",
    "theme_documentation_url": "https://github.com/anirudhatalmale6-alt/halloween-store-demo",
    "theme_support_url": "https://github.com/anirudhatalmale6-alt/halloween-store-demo"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image",
        "info": "Leave empty to use the text logo below with the drawn pumpkin mark."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 60,
        "max": 260,
        "step": 10,
        "unit": "px",
        "default": 150
      },
      {
        "type": "text",
        "id": "logo_text_a",
        "label": "Logo text - first word",
        "default": "Hollow"
      },
      {
        "type": "text",
        "id": "logo_text_b",
        "label": "Logo text - second word",
        "default": "Hex"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colours",
    "settings": [
      {
        "type": "paragraph",
        "content": "Every colour on the store comes from these. Change one here and it updates everywhere it is used."
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Page background",
        "default": "#0b0810"
      },
      {
        "type": "color",
        "id": "color_bg2",
        "label": "Alternate section background",
        "default": "#100b18"
      },
      {
        "type": "color",
        "id": "color_panel",
        "label": "Card background",
        "default": "#171021"
      },
      {
        "type": "color",
        "id": "color_panel2",
        "label": "Raised card background",
        "default": "#1e1529"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#f4efe6"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (buttons, links)",
        "default": "#ff7518"
      },
      {
        "type": "color",
        "id": "color_accent2",
        "label": "Accent light",
        "default": "#ffa250"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "Savings / in stock",
        "default": "#7bff6a"
      },
      {
        "type": "color",
        "id": "color_purple",
        "label": "Secondary accent",
        "default": "#a06bff"
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_show_rating",
        "label": "Show star rating",
        "default": true,
        "info": "Uses the product metafield reviews.rating if you have a reviews app, otherwise the fallback rating below."
      },
      {
        "type": "range",
        "id": "card_fallback_rating",
        "label": "Fallback rating",
        "min": 3,
        "max": 5,
        "step": 0.1,
        "default": 4.8
      },
      {
        "type": "checkbox",
        "id": "card_show_blurb",
        "label": "Show a short description on the card",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_save_badge",
        "label": "Show the percentage saved when a product is on sale",
        "default": true
      },
      {
        "type": "text",
        "id": "add_to_cart_text",
        "label": "Add button text",
        "default": "Add to Cart"
      }
    ]
  },
  {
    "name": "Shipping & guarantees",
    "settings": [
      {
        "type": "paragraph",
        "content": "Every delivery promise, guarantee and warehouse claim on the site is here, in one place. Change a line and it changes on the homepage, on every product page and in the cart at the same time. Empty a line and it disappears rather than leaving a gap."
      },
      {
        "type": "paragraph",
        "content": "Nothing here is enforced by the theme. If you promise 24-hour dispatch, that promise is yours to keep - so update these the day a supplier changes."
      },
      {
        "type": "header",
        "content": "Announcement bar"
      },
      {
        "type": "text",
        "id": "ship_announce_1",
        "label": "Line 1",
        "default": "FREE US SHIPPING ON EVERYTHING"
      },
      {
        "type": "text",
        "id": "ship_announce_2",
        "label": "Line 2",
        "default": "Order by Oct 20 and it lands before Halloween"
      },
      {
        "type": "header",
        "content": "Promises on every product page"
      },
      {
        "type": "text",
        "id": "ship_free",
        "label": "Shipping",
        "default": "Free US shipping, no minimum"
      },
      {
        "type": "text",
        "id": "ship_dispatch",
        "label": "Dispatch time",
        "default": "Ships within 24 hours from a US warehouse"
      },
      {
        "type": "text",
        "id": "ship_guarantee",
        "label": "Delivery guarantee",
        "default": "Guaranteed delivered before Oct 31 or it's free"
      },
      {
        "type": "text",
        "id": "ship_returns",
        "label": "Returns",
        "default": "30-day returns, no questions asked"
      },
      {
        "type": "header",
        "content": "Urgency"
      },
      {
        "type": "text",
        "id": "urgency_text",
        "label": "Line under the stock bar",
        "default": "Selling fast - limited stock left at this price",
        "info": "Empty this to remove the urgency line everywhere at once."
      },
      {
        "type": "header",
        "content": "Ratings"
      },
      {
        "type": "checkbox",
        "id": "card_use_fallback_rating",
        "label": "Show a made-up rating on products that have no reviews",
        "default": false,
        "info": "Off, and it should stay off. With this on, a product with zero reviews displays the fallback rating below as though it were real. Ratings come from the reviews.rating metafield, which the products CSV fills in from the supplier's own listing."
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart behaviour",
        "options": [
          {
            "value": "drawer",
            "label": "Slide-out drawer"
          },
          {
            "value": "page",
            "label": "Go to the cart page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "text",
        "id": "cart_note",
        "label": "Note under the checkout button",
        "default": "Secure checkout. Free US shipping on every order."
      },
      {
        "type": "text",
        "id": "free_shipping_text",
        "label": "Shipping line in the cart",
        "default": "Free"
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok"
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook"
      }
    ]
  }
]
