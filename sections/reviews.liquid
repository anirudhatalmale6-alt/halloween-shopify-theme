<section class="sec {% if section.settings.alt_bg %}sec--alt{% endif %}" id="{{ section.settings.anchor | default: 'reviews' }}">
  <div class="wrap">
    {%- if section.settings.kicker != blank -%}
      <p class="sec__k">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    <h2 class="sec__h">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.sub != blank -%}
      <p class="sec__sub">{{ section.settings.sub | escape }}</p>
    {%- endif -%}

    <div class="revs">
      {%- for block in section.blocks -%}
        <figure class="rev rv" {{ block.shopify_attributes }}>
          <div class="rev__stars">{% render 'stars', rating: block.settings.rating %}</div>
          <blockquote>{{ block.settings.quote | escape }}</blockquote>
          <figcaption>
            <strong>{{ block.settings.name | escape }}</strong>
            <span>{{ block.settings.place | escape }}</span>
            {%- if block.settings.verified -%}
              <span class="rev__v">Verified buyer</span>
            {%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "max_blocks": 9,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Small line above the heading",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What people said"
    },
    {
      "type": "textarea",
      "id": "sub",
      "label": "Text under the heading"
    },
    {
      "type": "checkbox",
      "id": "alt_bg",
      "label": "Use the alternate background",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id (for menu links)",
      "default": "reviews"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "place",
          "label": "Location"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show 'verified buyer'",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "quote": "Turned up three days after I ordered and the quality is way past what I paid. Neighbours have asked where it came from twice.",
            "name": "Danielle R.",
            "place": "Philadelphia, PA"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "I have bought Halloween stuff online for years and most of it is junk. This is the first time I would order again without thinking about it.",
            "name": "Marcus T.",
            "place": "Austin, TX"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "Ordered late and still had it before the weekend. Kids lost their minds.",
            "name": "Priya S.",
            "place": "Chicago, IL"
          }
        }
      ]
    }
  ]
}
{% endschema %}
