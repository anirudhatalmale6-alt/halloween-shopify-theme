<section class="sec sec--top">
  <div class="wrap">
    <p class="sec__k">{{ collection.products_count }} product{% if collection.products_count != 1 %}s{% endif %}</p>
    <h1 class="sec__h">{{ collection.title }}</h1>

    {%- if collection.description != blank -%}
      <div class="sec__sub rte">{{ collection.description }}</div>
    {%- endif -%}

    {%- paginate collection.products by section.settings.per_page -%}
      {%- if collection.products.size > 0 -%}
        <div class="grid">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pager" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a class="btn btn--ghost" href="{{ paginate.previous.url }}">Previous</a>
            {%- endif -%}
            <span class="pager__n">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {%- if paginate.next -%}
              <a class="btn btn--ghost" href="{{ paginate.next.url }}">Next</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="sec__empty">Nothing in this collection yet.</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ]
}
{% endschema %}
