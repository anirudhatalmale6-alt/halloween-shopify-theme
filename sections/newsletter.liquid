<section class="cap" id="{{ section.settings.anchor | default: 'newsletter' }}">
  <div class="wrap wrap--narrow">
    <h2>{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <p>{{ section.settings.text | escape }}</p>
    {%- endif -%}

    {%- comment -%}
      A real Shopify customer form, not a decorative one. The address lands in
      Customers with the "accepts marketing" flag, which is what makes it usable
      from an email tool later.
    {%- endcomment -%}
    {%- form 'customer', id: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="hidden" name="contact[accepts_marketing]" value="true">

      <div class="cap__f">
        <label class="visually-hidden" for="news-email">Email address</label>
        <input id="news-email" type="email" name="contact[email]"
               placeholder="{{ section.settings.placeholder | escape }}"
               autocomplete="email" required>
        <button class="btn btn--gold" type="submit">{{ section.settings.btn | escape }}</button>
      </div>

      <p class="cap__msg{% if form.errors %} err{% endif %}">
        {%- if form.posted_successfully? -%}
          {{ section.settings.success | escape }}
        {%- elsif form.errors -%}
          {{ form.errors | default_errors }}
        {%- endif -%}
      </p>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Email capture",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 10% off your first order"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "One email when something good lands. No daily nonsense."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Field placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "btn",
      "label": "Button text",
      "default": "Send it"
    },
    {
      "type": "text",
      "id": "success",
      "label": "Success message",
      "default": "You are in. Check your inbox for the code."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id (for menu links)",
      "default": "newsletter"
    }
  ],
  "presets": [
    {
      "name": "Email capture"
    }
  ]
}
{% endschema %}
