{%- comment -%}
  The two lines default to the shipping wording in Theme settings > Shipping
  & guarantees, so the delivery promise is stated in ONE place and repeated
  from there. Type something here and it overrides just this bar.
{%- endcomment -%}
{%- liquid
  assign strong = section.settings.strong | default: settings.ship_announce_1
  assign text = section.settings.text | default: settings.ship_announce_2
  assign has_copy = false
  if strong != blank or text != blank
    assign has_copy = true
  endif
-%}
{%- comment -%}
  Two separate ifs, not `show and a or b`. Liquid has no operator precedence
  and evaluates right to left, so a mixed and/or condition means something
  other than what it reads like.
{%- endcomment -%}
{%- if section.settings.show and has_copy -%}
  <div class="ann" role="region" aria-label="Announcement">
    <p>
      {%- comment -%}
        The &nbsp; is load-bearing. The whitespace-stripping tags either side
        eat a normal space, which ran the two halves together as
        "FREE US SHIPPINGON EVERY ORDER". An entity is not whitespace, so it
        survives the strip.
      {%- endcomment -%}
      {%- if strong != blank -%}
        <strong>{{ strong | escape }}</strong>&nbsp;
      {%- endif -%}
      {{ text | escape }}
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show",
      "label": "Show the announcement bar",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Leave both boxes empty to use the wording in Theme settings > Shipping & guarantees, so the delivery promise is written in one place only."
    },
    {
      "type": "text",
      "id": "strong",
      "label": "Highlighted words"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Message"
    }
  ]
}
{% endschema %}
