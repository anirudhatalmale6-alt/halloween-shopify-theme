<section class="sec {% if section.settings.alt_bg %}sec--alt{% endif %}" id="{{ section.settings.anchor | default: 'categories' }}">
  <div class="wrap">
    {%- if section.settings.kicker != blank -%}
      <p class="sec__k">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    <h2 class="sec__h">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.sub != blank -%}
      <p class="sec__sub">{{ section.settings.sub | escape }}</p>
    {%- endif -%}

    <div class="cats">
      {%- for block in section.blocks -%}
        {%- comment -%}
          The anchor wins over the collection URL. That is the whole point of
          this pass: clicking Apparel should scroll to the apparel products
          further down THIS page, not load a separate collection page. Clear
          the anchor on a tile and it goes back to linking to the collection.

          It is a plain text setting, not a `url` one - Shopify's URL picker
          will not accept "#cat-apparel".
        {%- endcomment -%}
        {%- liquid
          assign c = block.settings.collection
          assign href = ''
          if block.settings.anchor != blank
            assign href = block.settings.anchor | handleize | prepend: '#'
          elsif c != blank
            assign href = c.url
          elsif block.settings.link != blank
            assign href = block.settings.link
          else
            assign href = routes.all_products_collection_url
          endif
          comment
            `| default: 0`, because with no collection picked this is nil, and
            the `count > 0` test below then compares nil against a number.
            Shopify's Liquid swallows that and renders nothing; a stricter
            engine raises. Same visible result, but only one of them is a
            statement about the template rather than about the engine.
          endcomment
          assign count = c.products_count | default: 0
        -%}

        {%- comment -%}
          Tag fallback, same idea as the Collection row section: with no
          collection picked and no image uploaded, find the products carrying
          this tag and borrow the first one's photo.

          Without this a store that has just imported the products CSV shows six
          identical grey Shopify placeholder squares, because a tile's image
          comes from a collection and a CSV import cannot create collections.
          The shop is full and the tiles say it is empty - which is exactly what
          the client photographed and sent me.

          The tag defaults to the tile's own title, so the six tiles fill
          themselves in with no settings to change: "LED Masks" the tile finds
          "LED Masks" the tag. It also supplies the "6 products" count, which is
          why the scan runs whenever there is no collection rather than only
          when the picture is missing - uploading your own tile image should not
          silently delete the count underneath it.

          A collection, once made, wins over all of this. The tag route is what
          makes a fresh CSV import look like a shop on its own.
        {%- endcomment -%}
        {%- liquid
          assign cat_img = ''
          assign want = ''
          if c == blank
            assign want = block.settings.tag | default: block.settings.title | downcase | strip
          endif

          if want != blank
            assign need_img = false
            if block.settings.image == blank
              assign need_img = true
            endif
            assign tagged = 0
            for product in collections.all.products
              assign hit = false
              for t in product.tags
                assign tt = t | downcase | strip
                if tt == want
                  assign hit = true
                  break
                endif
              endfor
              if hit
                assign tagged = tagged | plus: 1
                if need_img and cat_img == blank and product.featured_image != blank
                  assign cat_img = product.featured_image
                endif
              endif
            endfor
            assign count = tagged
          endif
        -%}
        <a class="cat rv" href="{{ href }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 240 }}"
                 alt="{{ block.settings.title | escape }}" width="240" height="240" loading="lazy">
          {%- elsif c != blank and c.featured_image != blank -%}
            <img src="{{ c.featured_image | image_url: width: 240 }}"
                 alt="{{ c.title | escape }}" width="240" height="240" loading="lazy">
          {%- elsif cat_img != blank -%}
            <img src="{{ cat_img | image_url: width: 240 }}"
                 alt="{{ block.settings.title | escape }}" width="240" height="240" loading="lazy">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'cat__ph' }}
          {%- endif -%}

          <div class="cat__txt">
            <h3>{{ block.settings.title | default: c.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if count > 0 -%}
              <span class="cat__n">{{ count }} product{% if count != 1 %}s{% endif %}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Small line above the heading",
      "default": "Browse"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "textarea",
      "id": "sub",
      "label": "Text under the heading"
    },
    {
      "type": "checkbox",
      "id": "alt_bg",
      "label": "Use the alternate background",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id (for menu links)",
      "default": "categories"
    }
  ],
  "blocks": [
    {
      "type": "cat",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Falls back to the collection image, then to the first product carrying the tag below."
        },
        {
          "type": "text",
          "id": "tag",
          "label": "...or a product tag",
          "info": "Used for the picture and the product count when no collection is picked. Leave blank to use the title above as the tag - which is what the six default tiles do."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short description"
        },
        {
          "type": "text",
          "id": "anchor",
          "label": "Jump to a section on this page",
          "info": "e.g. cat-apparel. Must match the anchor on the Collection row section further down. Overrides the collection link - clear it to link to the collection page instead."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Only used when there is no anchor and no collection."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        {
          "type": "cat",
          "settings": {
            "title": "Decor"
          }
        },
        {
          "type": "cat",
          "settings": {
            "title": "Costumes"
          }
        },
        {
          "type": "cat",
          "settings": {
            "title": "Lighting"
          }
        },
        {
          "type": "cat",
          "settings": {
            "title": "Party"
          }
        }
      ]
    }
  ]
}
{% endschema %}
