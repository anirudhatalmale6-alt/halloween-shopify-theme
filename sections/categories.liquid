<section class="sec {% if section.settings.alt_bg %}sec--alt{% endif %}" id="{{ section.settings.anchor | default: 'categories' }}">
  <div class="wrap">
    {%- if section.settings.kicker != blank -%}
      <p class="sec__k">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    <h2 class="sec__h">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.sub != blank -%}
      <p class="sec__sub">{{ section.settings.sub | escape }}</p>
    {%- endif -%}

    <div class="cats">
      {%- for block in section.blocks -%}
        {%- comment -%}
          The anchor wins over the collection URL. That is the whole point of
          this pass: clicking Apparel should scroll to the apparel products
          further down THIS page, not load a separate collection page. Clear
          the anchor on a tile and it goes back to linking to the collection.

          It is a plain text setting, not a `url` one - Shopify's URL picker
          will not accept "#cat-apparel".
        {%- endcomment -%}
        {%- liquid
          assign c = block.settings.collection
          assign href = ''
          if block.settings.anchor != blank
            assign href = block.settings.anchor | handleize | prepend: '#'
          elsif c != blank
            assign href = c.url
          elsif block.settings.link != blank
            assign href = block.settings.link
          else
            assign href = routes.all_products_collection_url
          endif
          assign count = c.products_count
        -%}
        <a class="cat rv" href="{{ href }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 240 }}"
                 alt="{{ block.settings.title | escape }}" width="240" height="240" loading="lazy">
          {%- elsif c != blank and c.featured_image != blank -%}
            <img src="{{ c.featured_image | image_url: width: 240 }}"
                 alt="{{ c.title | escape }}" width="240" height="240" loading="lazy">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'cat__ph' }}
          {%- endif -%}

          <div class="cat__txt">
            <h3>{{ block.settings.title | default: c.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if count > 0 -%}
              <span class="cat__n">{{ count }} product{% if count != 1 %}s{% endif %}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Small line above the heading",
      "default": "Browse"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "textarea",
      "id": "sub",
      "label": "Text under the heading"
    },
    {
      "type": "checkbox",
      "id": "alt_bg",
      "label": "Use the alternate background",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id (for menu links)",
      "default": "categories"
    }
  ],
  "blocks": [
    {
      "type": "cat",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Falls back to the collection image."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short description"
        },
        {
          "type": "text",
          "id": "anchor",
          "label": "Jump to a section on this page",
          "info": "e.g. cat-apparel. Must match the anchor on the Collection row section further down. Overrides the collection link - clear it to link to the collection page instead."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Only used when there is no anchor and no collection."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        {
          "type": "cat",
          "settings": {
            "title": "Decor"
          }
        },
        {
          "type": "cat",
          "settings": {
            "title": "Costumes"
          }
        },
        {
          "type": "cat",
          "settings": {
            "title": "Lighting"
          }
        },
        {
          "type": "cat",
          "settings": {
            "title": "Party"
          }
        }
      ]
    }
  ]
}
{% endschema %}
