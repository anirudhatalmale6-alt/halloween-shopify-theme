<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  {% render 'font-face' %}
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    :root{
      --bg:{{ settings.color_bg }};--bg2:{{ settings.color_bg2 }};
      --panel:{{ settings.color_panel }};--panel2:{{ settings.color_panel2 }};
      --orange:{{ settings.color_accent }};--orange2:{{ settings.color_accent2 }};
      --green:{{ settings.color_success }};--bone:{{ settings.color_text }};
      --line:{{ settings.color_accent | color_modify: 'alpha', 0.16 }};
    }
  </style>
</head>
<body class="template-password">
  {{ content_for_layout }}
</body>
</html>
