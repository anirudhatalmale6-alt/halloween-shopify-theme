{%- comment -%}
  Star row.
    rating  - a number, e.g. 4.6
    count   - optional review count to print after the stars
    cls     - optional class for the count element

  The count element is given its OWN class rather than being targeted as
  `.wrapper span`. A tag selector next to a class outranks `.star--on`, which
  once repainted a whole 4.8 rating in muted grey.
{%- endcomment -%}
{%- assign r = rating | default: 0 | times: 1.0 -%}
{%- for i in (1..5) -%}
  {%- assign diff = r | minus: forloop.index -%}
  {%- if diff >= 0 -%}
    <span class="star star--on" aria-hidden="true">&#9733;</span>
  {%- elsif diff > -1 -%}
    <span class="star star--half" aria-hidden="true">&#9733;</span>
  {%- else -%}
    <span class="star" aria-hidden="true">&#9733;</span>
  {%- endif -%}
{%- endfor -%}
<span class="visually-hidden">{{ r }} out of 5 stars</span>
{%- if count -%}
  <span class="{{ cls | default: 'card__rcount' }}">{{ count }}</span>
{%- endif -%}
